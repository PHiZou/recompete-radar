# Postgres (Neon free tier works great)
# Format: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Where ingested parquet lands locally
DATA_DIR=./data/raw

# Optional: SAM.gov API key for Phase 2 opportunities ingest
SAM_API_KEY=

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Marts schema the API / alerts / dq_snapshot read (dbt target `dev` + marts).
MARTS_SCHEMA=dev_marts

# Contract-expiry alerting (pipelines/alerts.py)
# Delivery: set SENDGRID_API_KEY, or leave blank and use SMTP_* below.
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=sunlight@example.com
ALERT_EMAIL_TO=            # comma-separated recipients
ALERT_EXPIRY_MONTHS=3      # alert when POP ends within N months
ALERT_DEDUPE_DAYS=30       # don't re-alert an award within N days
